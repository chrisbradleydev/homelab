# https://github.com/cilium/cilium/blob/main/install/kubernetes/cilium/values.yaml

bgpControlPlane:
  # Enables the BGP control plane
  enabled: true

cni:
  # Make Cilium take ownership over the `/etc/cni/net.d` directory on the node
  exclusive: false

envoy:
  # Memory request for the cilium-envoy DaemonSet
  resources:
    requests:
      memory: 32Mi

hubble:
  # Enable Hubble
  enabled: true

ipam:
  # Configure IP Address Management mode
  # https://docs.cilium.io/en/stable/network/concepts/ipam/
  mode: "cluster-pool"
  operator:
    # IPv4 CIDR list range to delegate to individual nodes for IPAM
    clusterPoolIPv4PodCIDRList: ["10.0.0.0/8"]

# Kubernetes service host & port
k8sServiceHost: "{{ kubernetes_control_plane_address }}"
k8sServicePort: "{{ kubernetes_api_port }}"

# https://docs.cilium.io/en/stable/network/kubernetes/kubeproxy-free/
kubeProxyReplacement: "true"

# Interface for the datapath and L2 announcements. Pinned so auto-detection
# never picks up a NIC added later.
devices: eth0

# Serve Gateway API. tasks/gateway-api.yaml installs the CRDs first.
# https://docs.cilium.io/en/stable/network/servicemesh/gateway-api/gateway-api/
gatewayAPI:
  enabled: true

# Each announced LoadBalancer Service renews a lease through the API server.
# https://docs.cilium.io/en/stable/network/l2-announcements/#sizing-client-rate-limit
k8sClientRateLimit:
  qps: 20
  burst: 40

l2announcements:
  # Answer ARP for LoadBalancer IPs on the node LAN
  enabled: true

operator:
  # Memory request for cilium-operator
  resources:
    requests:
      memory: 64Mi
  # Restart the operator when its configuration changes, so the operator
  # registers the cilium GatewayClass
  rollOutPods: true

# Memory request for the cilium agent. This request and the envoy and operator
# requests sit just above what each pod uses on an idle node.
resources:
  requests:
    memory: 160Mi

# Roll out cilium agent pods automatically when configmap is updated
rollOutCiliumPods: true

socketLB:
  # Ensure Cilium does not interfere with Istio
  # https://docs.cilium.io/en/latest/network/servicemesh/istio/
  hostNamespaceOnly: true
