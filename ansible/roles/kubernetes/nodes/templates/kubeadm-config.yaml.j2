# https://kubernetes.io/docs/reference/config-api/kubeadm-config.v1beta4/
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
nodeRegistration:
  criSocket: "unix:///run/crio/crio.sock"
  imagePullPolicy: "IfNotPresent"
  imagePullSerial: true
# Set memory requests on the control plane static pods
patches:
  directory: /root/kubeadm-patches
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
networking:
  serviceSubnet: "{{ kubernetes_service_subnet }}"
  podSubnet: "{{ kubernetes_pod_subnet }}"
  dnsDomain: "{{ kubernetes_dns_domain }}"
kubernetesVersion: "v{{ kubernetes_version }}"
controlPlaneEndpoint: "{{ kubernetes_control_plane_endpoint }}"
apiServer:
  extraArgs:
    - name: authorization-mode
      value: Node,RBAC
    # Encrypt Secrets at rest in etcd (see tasks/etcd-encryption.yaml)
    - name: encryption-provider-config
      value: "{{ kubernetes_encryption_config }}"
    - name: encryption-provider-config-automatic-reload
      value: "true"
  extraVolumes:
    - name: encryption-config
      hostPath: "{{ kubernetes_encryption_config | dirname }}"
      mountPath: "{{ kubernetes_encryption_config | dirname }}"
      readOnly: true
      pathType: DirectoryOrCreate
# Cilium replaces kube-proxy, see tasks/kube-proxy.yaml
proxy:
  disabled: true
---
# https://kubernetes.io/docs/reference/config-api/kube-proxy-config.v1alpha1/
# Unused while proxy.disabled is true. Declares the mode kube-proxy would run
# in if the addon were enabled again.
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
mode: "{{ kubernetes_kube_proxy_mode }}"
---
# https://kubernetes.io/docs/reference/config-api/kubelet-config.v1beta1/
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
eventBurst: 300
eventRecordQPS: 100
kubeAPIBurst: 300
kubeAPIQPS: 100
maxPods: 110
# Reserve headroom for the OS and for kubelet/CRI-O. The control plane is
# deliberately schedulable (see tasks/control-plane.yaml). Running nodes pick
# up changes through tasks/kubelet-reserved.yaml.
systemReserved:
  cpu: "{{ kubernetes_system_reserved_cpu }}"
  memory: "{{ kubernetes_system_reserved_memory }}"
kubeReserved:
  cpu: "{{ kubernetes_kube_reserved_cpu }}"
  memory: "{{ kubernetes_kube_reserved_memory }}"
evictionHard:
  memory.available: "{{ kubernetes_eviction_memory_available }}"
  nodefs.available: "{{ kubernetes_eviction_nodefs_available }}"
enforceNodeAllocatable:
  - pods
